@model List<Raceday.Mvc.ViewModels.CategoryVm>
@{
    var ev = ViewData["Event"] as Raceday.Mvc.ViewModels.EventVm;
}
<h2>Categories · @ev?.Name</h2>
<div class="row">
    <div class="col-md-6">
        <table class="table">
            <thead><tr><th>Name</th><th>Age</th><th>Action</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CategoryName</td>
                        <td>@c.MinAge - @c.MaxAge</td>
                        <td><form asp-action="DeleteCategory" method="post"><input type="hidden" name="id" value="@c.CategoryId" /><input type="hidden" name="eventId" value="@ev!.EventId" /><button class="btn btn-sm btn-danger">Delete</button></form></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <form asp-action="AddCategory" asp-route-eventId="@ev!.EventId" method="post" class="card p-3">
            <input name="CategoryName" class="form-control mb-2" placeholder="Name" required />
            <input name="MinAge" type="number" class="form-control mb-2" placeholder="Min Age" />
            <input name="MaxAge" type="number" class="form-control mb-2" placeholder="Max Age" />
            <button class="btn btn-primary">Add Category</button>
        </form>
    </div>
</div>